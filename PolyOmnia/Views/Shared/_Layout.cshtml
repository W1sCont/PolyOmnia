@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Configuration
@using Microsoft.AspNetCore.Mvc.Localization
@using PolyOmnia
@inject IHtmlLocalizer<SharedResource> SharedLocalizer
@inject IConfiguration Configuration

@{
    // 1. Отримуємо список кодів мов з appsettings.json ("Lang")
    var langSection = Configuration.GetSection("Lang");
    var cultureCodes = langSection.GetChildren().Select(c => c.Key).ToList();

    // 2. Визначаємо поточну мову з потоку / RequestCulture
    var currentCultureFeature = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = currentCultureFeature?.RequestCulture.Culture.TwoLetterISOLanguageName.ToUpper()
                         ?? cultureCodes.FirstOrDefault()?.ToUpper()
                         ?? "UA";

    // Повертає назву мови або fallback значення
    string GetLangDisplayName(string code) => langSection[code] ?? code.ToUpper();
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PolyOmnia</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top px-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <i class="bi bi-infinity brand-icon"></i>
                <span class="brand-logo-text">PolyOmnia</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-2">
                    <li class="nav-item">
                        <a class="nav-link text-light d-flex align-items-center gap-1" href="#categories">
                            <i class="bi bi-grid-3x3-gap"></i> Категорії
                        </a>
                    </li>
                </ul>

                <!-- Пошук -->
                <form class="d-flex me-3" role="search" asp-controller="Home" asp-action="Index" method="get">
                    <input class="form-control form-control-poly me-2 rounded-pill px-3" type="search" name="search" placeholder="Пошук у PolyOmnia..." aria-label="Search">
                </form>

                <!-- Мова -->
                <div class="dropdown me-2">
                    <button class="btn btn-sm btn-dark border-secondary dropdown-toggle d-flex align-items-center gap-2 px-3 py-1 text-light shadow-sm"
                            type="button"
                            id="languageDropdown"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            style="background-color: #16161a;">
                        <i class="bi bi-globe text-primary fs-6"></i>
                        <span class="fw-semibold text-uppercase">@currentCulture</span>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end border-secondary shadow-lg py-1 mt-1"
                        aria-labelledby="languageDropdown"
                        style="background-color: #121215; min-width: 140px;">

                        @foreach (var code in cultureCodes)
                        {
                            var isSelected = string.Equals(currentCulture, code, StringComparison.OrdinalIgnoreCase);
                            var displayName = GetLangDisplayName(code);

                            <li>
                                <form asp-controller="Home" asp-action="SetLanguage" method="post" class="m-0">
                                    <input type="hidden" name="culture" value="@code" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between py-2 px-3 fs-7 @(isSelected ? "active bg-primary text-white" : "text-light opacity-75")">
                                        <span>@displayName</span>
                                        <span class="badge bg-secondary opacity-50 ms-2 text-uppercase fs-8">@code</span>
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>

                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <!-- Блок для залогованого користувача -->
                        <div class="dropdown">
                            <button class="btn btn-outline-brand dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i>
                                <span>@User.Identity.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                                <li><a class="dropdown-item" asp-controller="Video" asp-action="Create"><i class="bi bi-person me-2"></i>Додати відео</a></li>
                                <li><hr class="dropdown-divider"></li>
                                @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Genre" asp-action="Index"><i class="bi bi-tags me-1"></i> Категорії модерація</a></li>
                                }
                                <li>
                                    <form asp-controller="Admin" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Вийти
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <!-- Блок для гостей -->
                        <a asp-controller="Admin" asp-action="Login" class="btn btn-brand rounded-pill px-3">
                            <i class="bi bi-person-fill me-1"></i> Профіль / Вхід
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <div class="container my-4">
        @RenderBody()
    </div>

    <footer class="footer border-top border-secondary py-4 my-4 text-center text-muted">
        <p class="mb-1">&copy; 2026 - <strong style="color: var(--electric-indigo)">PolyOmnia</strong>. One Universe. Infinite Stories.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>